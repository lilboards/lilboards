{
  "name": "lilboards",
  "version": "4.43.1",
  "description": "Create boards, columns, and items.",
  "author": "Mark <mark@remarkablemark.org>",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf *.log coverage dist",
    "cypress:open": "cypress open",
    "dev": "vite --host --open",
    "firebase:deploy:database": "firebase deploy --only database",
    "firebase:emulators": "firebase emulators:start --only auth,database",
    "firebase:init": "firebase init",
    "firebase:login": "firebase login",
    "firebase:logout": "firebase logout",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:tsc": "tsc",
    "prepare": "husky",
    "start": "run-p firebase:emulators dev",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:ci": "CI=true npm test -- --ci --coverage --colors",
    "test:rules": "firebase emulators:exec --only database --project test-lilboards 'npm test -- --config jest.rules.config.ts --runInBand'",
    "test:watch": "npm test -- --watch"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hello-pangea/dnd": "18.0.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@reduxjs/toolkit": "2.13.0",
    "debounce": "3.0.0",
    "firebase": "13.0.0",
    "firebaseui": "6.1.0",
    "linkify-react": "4.3.3",
    "linkifyjs": "4.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.0",
    "react-router-dom": "7.18.4",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.8",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "cypress": "16.2.0",
    "cypress-cucumber-steps": "3.64.3",
    "cypress-real-events": "1.15.1",
    "eslint": "10.12.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "firebase-tools": "15.33.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-fetch-mock": "4.2.0",
    "jest-watch-typeahead": "3.0.1",
    "lint-staged": "17.6.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-commonjs": "0.10.4",
    "web-vitals": "6.2.3"
  },
  "overrides": {
    "firebase": "$firebase",
    "pretty-format": {
      "react-is": "$react"
    }
  },
  "private": true,
  "license": "MIT"
}
