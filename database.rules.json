{
  "rules": {
    "boards": {
      "$board_id": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && auth.uid === root.child('boards').child($board_id).child('board').child('createdBy').val()",
        "board": {
          ".write": "auth != null && auth.token.email_verified === true && newData.child('createdBy').val() === auth.uid && (!data.exists() || data.child('createdBy').val() === auth.uid)"
        },
        "columns": {
          "$column_id": {
            ".write": "auth != null && auth.uid === root.child('boards').child($board_id).child('board').child('createdBy').val()",
            "itemIds": {
              ".write": "auth != null"
            }
          }
        },
        "items": {
          "$item_id": {
            ".write": "auth != null"
          }
        },
        "likes": {
          "items": {
            "$item_id": {
              ".write": "auth != null"
            }
          }
        }
      }
    },
    "lists": {
      "$list_id": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && auth.uid === root.child('lists').child($list_id).child('list').child('createdBy').val()",
        "list": {
          ".write": "auth != null && auth.token.email_verified === true && newData.child('createdBy').val() === auth.uid && (!data.exists() || data.child('createdBy').val() === auth.uid)"
        },
        "rows": {
          "$row_id": {
            ".write": "auth != null && auth.uid === root.child('lists').child($list_id).child('list').child('createdBy').val()",
            "itemIds": {
              ".write": "auth != null"
            }
          }
        },
        "items": {
          "$item_id": {
            ".write": "auth != null"
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid && auth.token.email_verified === true",
        ".write": "$uid === auth.uid && auth.token.email_verified === true"
      }
    }
  }
}
